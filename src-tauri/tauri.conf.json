{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Email Triage",
  "version": "0.1.0",
  "identifier": "com.haroldmei.emailtriage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Email Triage",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
